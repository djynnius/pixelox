# LF everywhere: snapshot and catalog tests compare bytes, and example scripts must run from a
# Windows checkout.
* text=auto eol=lf
*.png binary
*.jpg binary
*.ttf binary
*.pxo binary

# vendored third-party files are embedded and hashed byte for byte (ADR 0018)
crates/pixelox-render/vendor/**/*.js -text
crates/pixelox-render/vendor/**/*.json -text
