{
  "command": "filter.distort",
  "cli": "pixelox filter distort",
  "summary": "Wave, ripple, twirl, pinch, spherize, or polar",
  "category": "filter",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/filter.distort.params.json",
    "title": "pixelox filter.distort parameters",
    "description": "Wave, ripple, twirl, pinch, spherize, or polar",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "kind": {
        "type": "string",
        "enum": [
          "wave",
          "ripple",
          "twirl",
          "pinch",
          "spherize",
          "polar",
          "polar-inverse"
        ],
        "description": "wave, ripple, twirl, pinch, spherize, polar, or polar-inverse Type: choice.",
        "x-pixelox-kind": "choice"
      },
      "amount": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -100.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "pinch and spherize strength (negative reverses) Range: -100..100. Type: number.",
        "default": "50",
        "x-pixelox-kind": "float"
      },
      "angle": {
        "type": "string",
        "examples": [
          "45"
        ],
        "description": "twirl: degrees at the center (auto 90); wave: direction of travel (auto 0) Type: degrees.",
        "default": "auto",
        "x-pixelox-kind": "angle"
      },
      "amplitude": {
        "type": "string",
        "examples": [
          "12px"
        ],
        "description": "wave and ripple height in px or % of the shorter side (auto 2%) Type: length.",
        "default": "auto",
        "x-pixelox-kind": "length"
      },
      "wavelength": {
        "type": "string",
        "examples": [
          "12px"
        ],
        "description": "wave and ripple length in px or % of the shorter side (auto 12%) Type: length.",
        "default": "auto",
        "x-pixelox-kind": "length"
      },
      "shape": {
        "type": "string",
        "enum": [
          "sine",
          "triangle",
          "square"
        ],
        "description": "wave profile Type: choice.",
        "default": "sine",
        "x-pixelox-kind": "choice"
      },
      "center": {
        "type": "string",
        "examples": [
          "50%,120"
        ],
        "description": "Center X,Y on the canvas (default: the center of the layer's visible bounds) Type: X,Y.",
        "x-pixelox-kind": "point"
      },
      "radius": {
        "type": "string",
        "examples": [
          "12px"
        ],
        "description": "twirl, pinch, spherize, ripple: reach in px or % of the shorter side (auto: half the bounds' shorter side; ripple: everywhere) Type: length.",
        "default": "auto",
        "x-pixelox-kind": "length"
      },
      "edge": {
        "type": "string",
        "enum": [
          "auto",
          "clamp",
          "wrap",
          "transparent"
        ],
        "description": "Pixels pulled from outside the layer: auto (clamp on opaque layers, transparent otherwise), clamp, wrap, or transparent Type: choice.",
        "default": "auto",
        "x-pixelox-kind": "choice"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "mask": {
        "type": "string",
        "examples": [
          "@sel"
        ],
        "description": "Limit the effect to a mask: a named mask, @sel, @alpha:<layer>, @mask:<layer>, or a grayscale image path Type: mask.",
        "x-pixelox-kind": "mask"
      },
      "invert_mask": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Apply outside the mask instead of inside it Type: flag.",
        "x-pixelox-kind": "flag"
      }
    },
    "required": [
      "input",
      "kind"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/filter.distort.result.json",
    "title": "pixelox filter.distort envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "filter.distort"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
