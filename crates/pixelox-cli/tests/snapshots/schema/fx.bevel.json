{
  "command": "fx.bevel",
  "cli": "pixelox fx bevel",
  "summary": "Add or replace a layer's bevel & emboss",
  "category": "fx",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/fx.bevel.params.json",
    "title": "pixelox fx.bevel parameters",
    "description": "Add or replace a layer's bevel & emboss",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "style": {
        "type": "string",
        "enum": [
          "inner",
          "outer",
          "emboss",
          "pillow"
        ],
        "description": "Where the bevel sits relative to the edge Type: choice.",
        "default": "inner",
        "x-pixelox-kind": "choice"
      },
      "depth": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 1.0,
            "maximum": 1000.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Steepness of the bevel in percent Range: 1..1000. Type: number.",
        "default": "100",
        "x-pixelox-kind": "float"
      },
      "size": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 250.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Width of the bevel in px Range: 0..250. Type: number.",
        "default": "5",
        "x-pixelox-kind": "float"
      },
      "soften": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 16.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Blur of the shading in px Range: 0..16. Type: number.",
        "default": "0",
        "x-pixelox-kind": "float"
      },
      "angle": {
        "type": "string",
        "examples": [
          "45"
        ],
        "description": "Light direction in degrees (0 = from the right, 90 = from above) Type: degrees.",
        "default": "120",
        "x-pixelox-kind": "angle"
      },
      "altitude": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 90.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Light height above the surface in degrees Range: 0..90. Type: number.",
        "default": "30",
        "x-pixelox-kind": "float"
      },
      "direction": {
        "type": "string",
        "enum": [
          "up",
          "down"
        ],
        "description": "Raised (up) or sunken (down) Type: choice.",
        "default": "up",
        "x-pixelox-kind": "choice"
      },
      "highlight": {
        "type": "string",
        "examples": [
          "#0ea5e9"
        ],
        "description": "Highlight color Type: color.",
        "default": "#ffffff",
        "x-pixelox-kind": "color"
      },
      "shadow": {
        "type": "string",
        "examples": [
          "#0ea5e9"
        ],
        "description": "Shadow color Type: color.",
        "default": "#000000",
        "x-pixelox-kind": "color"
      },
      "shadow_blend": {
        "type": "string",
        "enum": [
          "normal",
          "dissolve",
          "darken",
          "multiply",
          "color-burn",
          "linear-burn",
          "darker-color",
          "lighten",
          "screen",
          "color-dodge",
          "linear-dodge",
          "lighter-color",
          "overlay",
          "soft-light",
          "hard-light",
          "vivid-light",
          "linear-light",
          "pin-light",
          "hard-mix",
          "difference",
          "exclusion",
          "subtract",
          "divide",
          "hue",
          "saturation",
          "color",
          "luminosity"
        ],
        "description": "Blend mode of the shadow side Type: choice.",
        "default": "multiply",
        "x-pixelox-kind": "choice"
      },
      "blend": {
        "type": "string",
        "enum": [
          "normal",
          "dissolve",
          "darken",
          "multiply",
          "color-burn",
          "linear-burn",
          "darker-color",
          "lighten",
          "screen",
          "color-dodge",
          "linear-dodge",
          "lighter-color",
          "overlay",
          "soft-light",
          "hard-light",
          "vivid-light",
          "linear-light",
          "pin-light",
          "hard-mix",
          "difference",
          "exclusion",
          "subtract",
          "divide",
          "hue",
          "saturation",
          "color",
          "luminosity"
        ],
        "description": "Blend mode of the highlight side Type: choice.",
        "default": "screen",
        "x-pixelox-kind": "choice"
      },
      "opacity": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Opacity of the effect in percent Range: 0..100. Type: number.",
        "default": "75",
        "x-pixelox-kind": "float"
      },
      "enabled": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "on|off; given alone, turns the layer's existing effect on or off and keeps its settings Type: on|off.",
        "default": "on",
        "x-pixelox-kind": "switch"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
