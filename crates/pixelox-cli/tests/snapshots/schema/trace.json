{
  "command": "trace",
  "cli": "pixelox trace",
  "summary": "Vectorize a bitmap into an SVG",
  "category": "svg",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/trace.params.json",
    "title": "pixelox trace parameters",
    "description": "Vectorize a bitmap into an SVG",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "mode": {
        "type": "string",
        "enum": [
          "color",
          "binary"
        ],
        "description": "color: posterized multi-color tracing; binary: single-color silhouette Type: choice.",
        "default": "color",
        "x-pixelox-kind": "choice"
      },
      "colors": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 2.0,
            "maximum": 64.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Palette size for --mode color Range: 2..64. Type: integer.",
        "default": "8",
        "x-pixelox-kind": "int"
      },
      "threshold": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0.0,
            "maximum": 256.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "--mode binary: pixels with luma below this (0-255) are traced Range: 0..256. Type: integer.",
        "default": "128",
        "x-pixelox-kind": "int"
      },
      "speckle": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0.0,
            "maximum": 1024.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Drop patches smaller than N x N px Range: 0..1024. Type: integer.",
        "default": "4",
        "x-pixelox-kind": "int"
      },
      "corner": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0.0,
            "maximum": 180.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Turns sharper than this many degrees stay corners (higher = smoother) Range: 0..180. Type: integer.",
        "default": "60",
        "x-pixelox-kind": "int"
      },
      "precision": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0.0,
            "maximum": 8.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Decimal places in the path data Range: 0..8. Type: integer.",
        "default": "2",
        "x-pixelox-kind": "int"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/trace.result.json",
    "title": "pixelox trace envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "trace"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^PXW[0-9]{4}$"
            },
            "message": {
              "type": "string"
            },
            "context": {
              "type": "object"
            }
          }
        }
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "docs",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^PX[0-9]{4}$"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "docs": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      }
    }
  },
  "errors": [
    "PX1002",
    "PX1003",
    "PX1004",
    "PX1010",
    "PX1013",
    "PX1101",
    "PX1103",
    "PX1105",
    "PX1106",
    "PX1401",
    "PX1403",
    "PX9001"
  ]
}
