{
  "command": "shape.set",
  "cli": "pixelox shape set",
  "summary": "Restyle an existing shape layer",
  "category": "vector",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/shape.set.params.json",
    "title": "pixelox shape.set parameters",
    "description": "Restyle an existing shape layer",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "fill": {
        "type": "string",
        "description": "New fill color (CSS color), or none to remove the fill Type: text.",
        "x-pixelox-kind": "str"
      },
      "stroke": {
        "type": "string",
        "description": "New stroke color (CSS color), or none to remove the stroke Type: text.",
        "x-pixelox-kind": "str"
      },
      "stroke_width": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 10000.0
          },
          {
            "type": "string"
          }
        ],
        "description": "New stroke width in px Range: 0..10000. Type: number.",
        "x-pixelox-kind": "float"
      },
      "dash": {
        "description": "Dash pattern in px, e.g. '4,2' (none = solid) Type: list. Repeatable.",
        "oneOf": [
          {
            "type": "string",
            "description": "Dash pattern in px, e.g. '4,2' (none = solid) Type: list.",
            "x-pixelox-kind": "list"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Dash pattern in px, e.g. '4,2' (none = solid) Type: list.",
              "x-pixelox-kind": "list"
            }
          }
        ]
      },
      "dash_offset": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "description": "Offset into the dash pattern in px Type: number.",
        "x-pixelox-kind": "float"
      },
      "cap": {
        "type": "string",
        "enum": [
          "butt",
          "round",
          "square"
        ],
        "description": "Line cap at open path ends Type: choice.",
        "x-pixelox-kind": "choice"
      },
      "join": {
        "type": "string",
        "enum": [
          "miter",
          "round",
          "bevel"
        ],
        "description": "Line join at corners Type: choice.",
        "x-pixelox-kind": "choice"
      },
      "miter_limit": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 1.0,
            "maximum": 1000.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Miter limit (ratio of miter length to stroke width) Range: 1..1000. Type: number.",
        "x-pixelox-kind": "float"
      },
      "fill_rule": {
        "type": "string",
        "enum": [
          "nonzero",
          "evenodd"
        ],
        "description": "Fill rule for self-overlapping paths and holes Type: choice.",
        "x-pixelox-kind": "choice"
      },
      "opacity": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Layer opacity 0-100 Range: 0..100. Type: number.",
        "x-pixelox-kind": "float"
      },
      "name": {
        "type": "string",
        "description": "Rename the layer Type: text.",
        "x-pixelox-kind": "str"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/shape.set.result.json",
    "title": "pixelox shape.set envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
