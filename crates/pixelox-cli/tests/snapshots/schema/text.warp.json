{
  "command": "text.warp",
  "cli": "pixelox text warp",
  "summary": "Warp a text layer with a preset, keeping it live",
  "category": "text",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/text.warp.params.json",
    "title": "pixelox text.warp parameters",
    "description": "Warp a text layer with a preset, keeping it live",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Text layer: name, #N (1 = top), @top, @bottom, or @active; defaults to the only text layer Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "preset": {
        "type": "string",
        "enum": [
          "none",
          "arc",
          "arc-lower",
          "arc-upper",
          "arch",
          "bulge",
          "shell-lower",
          "shell-upper",
          "flag",
          "wave",
          "fish",
          "rise",
          "fisheye",
          "inflate",
          "squeeze",
          "twist"
        ],
        "description": "arc, arc-lower, arc-upper, arch, bulge, shell-lower, shell-upper, flag, wave, fish, rise, fisheye, inflate, squeeze, twist, or none Type: choice.",
        "x-pixelox-kind": "choice"
      },
      "bend": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -100.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Strength in % (negative bends the other way) Range: -100..100. Type: number.",
        "default": "50",
        "x-pixelox-kind": "float"
      },
      "h_distort": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -100.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Horizontal distortion in %: a perspective that grows the right side (negative: the left) Range: -100..100. Type: number.",
        "default": "0",
        "x-pixelox-kind": "float"
      },
      "v_distort": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -100.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Vertical distortion in %: a perspective that grows the bottom (negative: the top) Range: -100..100. Type: number.",
        "default": "0",
        "x-pixelox-kind": "float"
      },
      "orient": {
        "type": "string",
        "enum": [
          "horizontal",
          "vertical"
        ],
        "description": "Bend along the horizontal or the vertical axis Type: choice.",
        "default": "horizontal",
        "x-pixelox-kind": "choice"
      }
    },
    "required": [
      "input",
      "preset"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/text.warp.result.json",
    "title": "pixelox text.warp envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "text.warp"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^PXW[0-9]{4}$"
            },
            "message": {
              "type": "string"
            },
            "context": {
              "type": "object"
            }
          }
        }
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "docs",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^PX[0-9]{4}$"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "docs": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      }
    }
  },
  "errors": [
    "PX1002",
    "PX1003",
    "PX1004",
    "PX1010",
    "PX1013",
    "PX1101",
    "PX1103",
    "PX1105",
    "PX1106",
    "PX1108",
    "PX1401",
