{
  "command": "fill.content-aware",
  "cli": "pixelox fill content-aware",
  "summary": "Fill a region from its surroundings (inpaint)",
  "category": "retouch",
  "mode": "export",
  "milestone": "v0.2",
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/fill.content-aware.params.json",
    "title": "pixelox fill.content-aware parameters",
    "description": "Fill a region from its surroundings (inpaint)",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "mask": {
        "type": "string",
        "examples": [
          "@sel"
        ],
        "description": "Region to fill Type: mask.",
        "x-pixelox-kind": "mask"
      },
      "model": {
        "type": "string",
        "enum": [
          "lama"
        ],
        "description": "Inpainting model Type: choice.",
        "default": "lama",
        "x-pixelox-kind": "choice"
      },
      "expand": {
        "type": "string",
        "examples": [
          "12px"
        ],
        "description": "Grow the region by this many px first Type: length.",
        "default": "0",
        "x-pixelox-kind": "length"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      }
    },
    "required": [
      "input",
      "mask"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/fill.content-aware.result.json",
    "title": "pixelox fill.content-aware envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "fill.content-aware"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
