{
  "command": "filter.cartoon",
  "cli": "pixelox filter cartoon",
  "summary": "Cartoon: flat color areas with bold outlines",
  "category": "filter",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/filter.cartoon.params.json",
    "title": "pixelox filter.cartoon parameters",
    "description": "Cartoon: flat color areas with bold outlines",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "levels": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 2.0,
            "maximum": 32.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Lightness bands per color (fewer = flatter) Range: 2..32. Type: integer.",
        "default": "5",
        "x-pixelox-kind": "int"
      },
      "stroke": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.2,
            "maximum": 200.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Outline width in px; auto = 2.2 × √(w·h)/1000 (recorded) Range: 0.2..200. Type: number.",
        "default": "auto",
        "x-pixelox-kind": "float"
      },
      "edges": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Outline strength (0 = no outlines) Range: 0..100. Type: number.",
        "default": "70",
        "x-pixelox-kind": "float"
      },
      "detail": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Outline detail: 0 = only major shapes, 100 = small features too Range: 0..100. Type: number.",
        "default": "40",
        "x-pixelox-kind": "float"
      },
      "smooth": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.5,
            "maximum": 500.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Flattening radius in px; auto = 3.5 × √(w·h)/1000 (recorded) Range: 0.5..500. Type: number.",
        "default": "auto",
        "x-pixelox-kind": "float"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "mask": {
        "type": "string",
        "examples": [
          "@sel"
        ],
        "description": "Limit the effect to a mask: a named mask, @sel, @alpha:<layer>, @mask:<layer>, or a grayscale image path Type: mask.",
        "x-pixelox-kind": "mask"
      },
      "invert_mask": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Apply outside the mask instead of inside it Type: flag.",
        "x-pixelox-kind": "flag"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/filter.cartoon.result.json",
    "title": "pixelox filter.cartoon envelope",
    "type": "object",
    "required": [
