{
  "command": "mask.add",
  "cli": "pixelox mask add",
  "summary": "Attach a layer mask",
  "category": "mask",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/mask.add.params.json",
    "title": "pixelox mask.add parameters",
    "description": "Attach a layer mask",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Layer to mask (default: the only layer) Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "from": {
        "type": "string",
        "examples": [
          "@sel"
        ],
        "description": "Mask reference: @sel, a library name, @alpha:<layer>, or @mask:<layer> Type: mask.",
        "x-pixelox-kind": "mask"
      },
      "from_file": {
        "type": "string",
        "description": "Grayscale image the size of the canvas Type: path.",
        "x-pixelox-kind": "path"
      },
      "reveal_all": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "A white mask (everything visible) Type: flag.",
        "x-pixelox-kind": "flag"
      },
      "hide_all": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "A black mask (everything hidden) Type: flag.",
        "x-pixelox-kind": "flag"
      },
      "from_path": {
        "type": "string",
        "description": "SVG path data in canvas pixels: a vector mask Type: text.",
        "x-pixelox-kind": "str"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
