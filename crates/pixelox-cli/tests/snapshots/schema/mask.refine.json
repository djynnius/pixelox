{
  "command": "mask.refine",
  "cli": "pixelox mask refine",
  "summary": "Refine a mask's edge: hair-level alpha and clean colors",
  "category": "mask",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/mask.refine.params.json",
    "title": "pixelox mask.refine parameters",
    "description": "Refine a mask's edge: hair-level alpha and clean colors",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "mask": {
        "type": "string",
        "examples": [
          "@sel"
        ],
        "description": "The rough mask: a library name, @sel, @mask:<layer>, @alpha:<layer>, or a grayscale image the size of the canvas Type: mask.",
        "x-pixelox-kind": "mask"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Image to pull alpha from, and the raster layer --decontaminate rewrites (default: the layer of an @mask:/@alpha: reference, else the composite; the only layer with --decontaminate) Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "band": {
        "type": "string",
        "examples": [
          "12px"
        ],
        "description": "How far on each side of the rough edge alpha is re-solved, px (% of the shorter side); auto = 0.8% of the long side (none with --unknown) Type: length.",
        "default": "auto",
        "x-pixelox-kind": "length"
      },
      "unknown": {
        "type": "string",
        "examples": [
          "@sel"
        ],
        "description": "Explicit unknown band (Extract's highlighter), e.g. painted with paint stroke --into; used instead of --band unless --band is also given Type: mask.",
        "x-pixelox-kind": "mask"
      },
      "force_foreground": {
        "type": "string",
        "examples": [
          "#0ea5e9"
        ],
        "description": "Take band alpha from this foreground color against the local background (wispy hair of one color) Type: color.",
        "x-pixelox-kind": "color"
      },
      "decontaminate": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Write background-free foreground colors into the layer's pixels in the band (removes color fringes) Type: flag.",
        "x-pixelox-kind": "flag"
      },
      "into": {
        "type": "string",
        "description": "Where the refined mask goes: a library name, @sel, or @mask:<layer> (default: replace --mask) Type: text.",
        "x-pixelox-kind": "str"
      },
      "model": {
        "type": "string",
        "enum": [
          "closed-form",
          "vitmatte"
        ],
        "description": "Alpha solver: closed-form (the matting Laplacian, no model) or vitmatte (a model, not in this release) Type: choice.",
        "default": "closed-form",
        "x-pixelox-kind": "choice"
      }
    },
    "required": [
      "input",
      "mask"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/mask.refine.result.json",
    "title": "pixelox mask.refine envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "mask.refine"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^PXW[0-9]{4}$"
            },
            "message": {
              "type": "string"
            },
            "context": {
              "type": "object"
            }
          }
        }
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "docs",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^PX[0-9]{4}$"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "docs": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      }
    }
  },
  "errors": [
    "PX1002",
    "PX1003",
    "PX1004",
    "PX1010",
    "PX1011",
    "PX1012",
    "PX1101",
