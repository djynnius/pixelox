{
  "command": "render.lens-flare",
  "cli": "pixelox render lens-flare",
  "summary": "Add a camera lens flare as a new screen layer",
  "category": "render",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/render.lens-flare.params.json",
    "title": "pixelox render.lens-flare parameters",
    "description": "Add a camera lens flare as a new screen layer",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "at": {
        "type": "string",
        "examples": [
          "50%,120"
        ],
        "description": "Flare center X,Y in px or % of the canvas (negative counts from the right/bottom) Type: X,Y.",
        "default": "30%,30%",
        "x-pixelox-kind": "point"
      },
      "lens": {
        "type": "string",
        "enum": [
          "zoom",
          "35mm",
          "105mm",
          "movie"
        ],
        "description": "Lens type: zoom (50-300 mm), 35mm prime, 105mm prime, or movie prime Type: choice.",
        "default": "zoom",
        "x-pixelox-kind": "choice"
      },
      "brightness": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 10.0,
            "maximum": 300.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Flare brightness in percent Range: 10..300. Type: number.",
        "default": "100",
        "x-pixelox-kind": "float"
      },
      "color": {
        "type": "string",
        "examples": [
          "#0ea5e9"
        ],
        "description": "Tint the whole flare with this color (default: the lens's own colors) Type: color.",
        "x-pixelox-kind": "color"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Put the flare layer above this layer (default: above the active layer, or on top) Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "name": {
        "type": "string",
        "description": "Name for the new layer (default: Lens Flare, made unique) Type: text.",
        "x-pixelox-kind": "str"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/render.lens-flare.result.json",
    "title": "pixelox render.lens-flare envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
