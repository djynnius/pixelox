          },
          "docs": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      }
    }
  },
  "errors": [
    "PX1002",
    "PX1003",
    "PX1004",
