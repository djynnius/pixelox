{
  "command": "analyze.stats",
  "cli": "pixelox analyze stats",
  "summary": "Channel statistics; a 1×1 --rect is an eyedropper",
  "category": "analyze",
  "mode": "read_only",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/analyze.stats.params.json",
    "title": "pixelox analyze.stats parameters",
    "description": "Channel statistics; a 1×1 --rect is an eyedropper",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Measure one layer (name, #N, @top, @bottom, @active) instead of the flattened composite Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "rect": {
        "type": "string",
        "examples": [
          "10,20,300x200"
        ],
        "description": "Region X,Y,WxH in canvas coordinates (default: the whole canvas) Type: X,Y,WxH.",
        "x-pixelox-kind": "rect"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/analyze.stats.result.json",
    "title": "pixelox analyze.stats envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "analyze.stats"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
