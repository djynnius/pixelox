{
  "command": "fx.smoke",
  "cli": "pixelox fx smoke",
  "summary": "Add or replace smoke rising from a layer's outline",
  "category": "fx",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/fx.smoke.params.json",
    "title": "pixelox fx.smoke parameters",
    "description": "Add or replace smoke rising from a layer's outline",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "height": {
        "type": "string",
        "examples": [
          "12px"
        ],
        "description": "Smoke height: px, or % of the layer's height (its size along --drift) Type: length.",
        "default": "80%",
        "x-pixelox-kind": "length"
      },
      "turbulence": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "How much the plume wavers and breaks up, in percent Range: 0..100. Type: number.",
        "default": "50",
        "x-pixelox-kind": "float"
      },
      "variant": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0.0,
            "maximum": 4294967295.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Noise pattern number: the same number draws the same shapes; auto keeps the layer's current pattern or picks one from the op's seed (--seed) Range: 0..4294967295. Type: integer.",
        "default": "auto",
        "x-pixelox-kind": "int"
      },
      "density": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Opacity of the thickest smoke in percent Range: 0..100. Type: number.",
        "default": "50",
        "x-pixelox-kind": "float"
      },
      "drift": {
        "type": "string",
        "examples": [
          "45"
        ],
        "description": "Direction the smoke drifts in degrees (90 = up, 60 = up and to the right) Type: degrees.",
        "default": "90",
        "x-pixelox-kind": "angle"
      },
      "color": {
        "type": "string",
        "examples": [
          "#0ea5e9"
        ],
        "description": "Smoke color (lighter and darker shades of it are mixed in) Type: color.",
        "default": "#8c8c8c",
        "x-pixelox-kind": "color"
      },
      "blend": {
        "type": "string",
        "enum": [
          "normal",
          "dissolve",
          "darken",
          "multiply",
          "color-burn",
          "linear-burn",
          "darker-color",
          "lighten",
          "screen",
          "color-dodge",
          "linear-dodge",
          "lighter-color",
          "overlay",
          "soft-light",
          "hard-light",
          "vivid-light",
          "linear-light",
          "pin-light",
          "hard-mix",
          "difference",
          "exclusion",
          "subtract",
          "divide",
          "hue",
          "saturation",
          "color",
          "luminosity"
        ],
        "description": "Blend mode of the smoke Type: choice.",
        "default": "normal",
        "x-pixelox-kind": "choice"
      },
      "opacity": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Opacity of the effect in percent Range: 0..100. Type: number.",
        "default": "100",
        "x-pixelox-kind": "float"
      },
      "enabled": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "on|off; given alone, turns the layer's existing effect on or off and keeps its settings Type: on|off.",
        "default": "on",
        "x-pixelox-kind": "switch"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/fx.smoke.result.json",
    "title": "pixelox fx.smoke envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "fx.smoke"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^PXW[0-9]{4}$"
            },
            "message": {
              "type": "string"
            },
            "context": {
              "type": "object"
            }
          }
        }
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "docs",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^PX[0-9]{4}$"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "docs": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      }
    }
  },
  "errors": [
    "PX1002",
    "PX1003",
    "PX1004",
    "PX1010",
    "PX1011",
    "PX1012",
    "PX1013",
    "PX1101",
    "PX1103",
    "PX1105",
    "PX1106",
    "PX1108",
    "PX1401",
    "PX1403",
    "PX2301",
    "PX2302",
    "PX2304",
    "PX9001"
  ]
}
