{
  "command": "layer.smart-filter",
  "cli": "pixelox layer smart-filter",
  "summary": "Disable, enable, or remove a smart filter",
  "category": "layer",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/layer.smart-filter.params.json",
    "title": "pixelox layer.smart-filter parameters",
    "description": "Disable, enable, or remove a smart filter",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "action": {
        "type": "string",
        "enum": [
          "disable",
          "enable",
          "remove"
        ],
        "description": "What to do with the filter: disable, enable, or remove Type: choice.",
        "x-pixelox-kind": "choice"
      },
      "index": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Which filter, from 1 (default: the last) Range: 1... Type: integer.",
        "x-pixelox-kind": "int"
      }
    },
    "required": [
      "input",
      "action"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
