{
  "command": "layer.add",
  "cli": "pixelox layer add",
  "summary": "Add an empty or solid-filled raster layer",
  "category": "layer",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/layer.add.params.json",
    "title": "pixelox layer.add parameters",
    "description": "Add an empty or solid-filled raster layer",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "name": {
        "type": "string",
        "description": "Name for the new layer (default: 'Layer', made unique) Type: text.",
        "x-pixelox-kind": "str"
      },
      "size": {
        "type": "string",
        "examples": [
          "1080x1350"
        ],
        "description": "Layer size WxH in px or % of the canvas (default: the canvas size) Type: WxH.",
        "x-pixelox-kind": "size"
      },
      "at": {
        "type": "string",
        "examples": [
          "50%,120"
        ],
        "description": "Top-left corner X,Y on the canvas (default 0,0); negative values count from the right/bottom Type: X,Y.",
        "x-pixelox-kind": "point"
      },
      "fill": {
        "type": "string",
        "examples": [
          "#0ea5e9"
        ],
        "description": "Fill color (default: transparent) Type: color.",
        "x-pixelox-kind": "color"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
