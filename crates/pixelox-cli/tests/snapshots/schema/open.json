{
  "command": "open",
  "cli": "pixelox open",
  "summary": "Open any image as a document; inspect without -o",
  "category": "document",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/open.params.json",
    "title": "pixelox open parameters",
    "description": "Open any image as a document; inspect without -o",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "page": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1.0,
            "maximum": 100000.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Page of a multi-page TIFF (1-based) Range: 1..100000. Type: integer.",
        "x-pixelox-kind": "int"
      },
      "frame": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1.0,
            "maximum": 100000.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Frame of an animated GIF (1-based) Range: 1..100000. Type: integer.",
        "x-pixelox-kind": "int"
      },
      "icc": {
        "type": "string",
        "enum": [
          "honor",
          "assign",
          "ignore"
        ],
        "description": "Embedded ICC profile: honor (keep and re-embed), assign, or ignore Type: choice.",
        "default": "honor",
        "x-pixelox-kind": "choice"
      },
      "no_auto_orient": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Keep pixels as stored instead of applying EXIF orientation Type: flag.",
        "x-pixelox-kind": "flag"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/open.result.json",
    "title": "pixelox open envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "open"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^PXW[0-9]{4}$"
            },
            "message": {
              "type": "string"
            },
            "context": {
              "type": "object"
            }
          }
        }
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "docs",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^PX[0-9]{4}$"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "docs": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      }
    }
  },
  "errors": [
    "PX1002",
    "PX1003",
    "PX1004",
    "PX1010",
    "PX1013",
    "PX1101",
    "PX1103",
    "PX1105",
    "PX1106",
    "PX1401",
    "PX1403",
    "PX9001"
  ]
}
