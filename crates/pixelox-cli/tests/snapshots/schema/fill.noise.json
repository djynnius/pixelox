{
  "command": "fill.noise",
  "cli": "pixelox fill noise",
  "summary": "Clouds, smoke, fractal or cell noise",
  "category": "retouch",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/fill.noise.params.json",
    "title": "pixelox fill.noise parameters",
    "description": "Clouds, smoke, fractal or cell noise",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "kind": {
        "type": "string",
        "enum": [
          "clouds",
          "smoke",
          "turbulence",
          "ridged",
          "cells",
          "cell-edges"
        ],
        "description": "Pattern: clouds, smoke, turbulence, ridged, cells, or cell-edges Type: choice.",
        "default": "clouds",
        "x-pixelox-kind": "choice"
      },
      "stops": {
        "type": "string",
        "examples": [
          "#000@0,#fff@1"
        ],
        "description": "Colors from low to high noise: two colors ('#000,#fff', 'transparent,#fff') or stops with positions Type: stops.",
        "default": "#000000,#ffffff",
        "x-pixelox-kind": "stops"
      },
      "scale": {
        "type": "string",
        "examples": [
          "12px"
        ],
        "description": "Size of the largest features in px, or % of the canvas's shorter side; auto = 70% for smoke, else 40% Type: length.",
        "default": "auto",
        "x-pixelox-kind": "length"
      },
      "octaves": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1.0,
            "maximum": 12.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Detail layers summed (1 = smooth blobs, 8 = fine detail); auto = 1 for cells, 2 for cell-edges, 5 for smoke, else 6 Range: 1..12. Type: integer.",
        "default": "auto",
        "x-pixelox-kind": "int"
      },
      "persistence": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Strength of each finer octave relative to the last (higher = rougher) Range: 0..1. Type: number.",
        "default": "0.5",
        "x-pixelox-kind": "float"
      },
      "lacunarity": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 1.0,
            "maximum": 4.0
          },
          {
            "type": "string"
          }
        ],
        "description": "How much finer each octave is (a whole number with --tile) Range: 1..4. Type: number.",
        "default": "2",
        "x-pixelox-kind": "float"
      },
      "basis": {
        "type": "string",
        "enum": [
          "perlin",
          "simplex",
          "value"
        ],
        "description": "Noise function for clouds, smoke, turbulence, ridged: perlin, simplex, or value Type: choice.",
        "default": "perlin",
        "x-pixelox-kind": "choice"
      },
      "contrast": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -100.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Steepen (+) or flatten (−) the ramp; 100 gives hard-edged shapes Range: -100..100. Type: number.",
        "default": "0",
        "x-pixelox-kind": "float"
      },
      "bias": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -100.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Shift toward the high color (+) or the low color (−): more or less coverage Range: -100..100. Type: number.",
        "default": "0",
        "x-pixelox-kind": "float"
      },
      "warp": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 300.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Swirl (domain warp) in % of a feature; auto = 90 for smoke, else 0 Range: 0..300. Type: number.",
        "default": "auto",
        "x-pixelox-kind": "float"
      },
      "stretch": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Elongate features along --angle by this factor; auto = 1.8 for smoke, else 1 Range: 0.1..10. Type: number.",
        "default": "auto",
        "x-pixelox-kind": "float"
      },
      "angle": {
        "type": "string",
        "examples": [
          "45"
        ],
        "description": "Direction of --stretch in degrees (0 = horizontal, 90 = vertical) Type: degrees.",
        "default": "90",
        "x-pixelox-kind": "angle"
      },
      "tile": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Repeat seamlessly across the canvas edges (for pattern tiles) Type: flag.",
        "x-pixelox-kind": "flag"
      },
      "blend": {
        "type": "string",
        "enum": [
          "normal",
          "dissolve",
          "darken",
          "multiply",
          "color-burn",
          "linear-burn",
          "darker-color",
          "lighten",
          "screen",
          "color-dodge",
          "linear-dodge",
          "lighter-color",
          "overlay",
          "soft-light",
          "hard-light",
          "vivid-light",
          "linear-light",
          "pin-light",
          "hard-mix",
          "difference",
          "exclusion",
          "subtract",
          "divide",
          "hue",
          "saturation",
          "color",
          "luminosity"
        ],
        "description": "How the noise combines with the pixels (difference = Difference Clouds); with --as-layer, the new layer's mode Type: choice.",
        "default": "normal",
        "x-pixelox-kind": "choice"
      },
      "opacity": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Opacity of the noise in percent (with --as-layer, the layer's opacity) Range: 0..100. Type: number.",
        "default": "100",
        "x-pixelox-kind": "float"
      },
      "as_layer": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Paint onto a new canvas-sized layer instead: on top of the stack, directly above --layer, or where --above/--below/--into say Type: flag.",
        "x-pixelox-kind": "flag"
      },
      "name": {
        "type": "string",
        "description": "Name for the new layer (default: generated, unique) Type: text.",
        "x-pixelox-kind": "str"
      },
      "above": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Insert the new layer directly above this layer (default: on top of the stack) Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "below": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Insert the new layer directly below this layer Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "into": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Insert the new layer on top of this group's children Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "mask": {
        "type": "string",
        "examples": [
          "@sel"
        ],
        "description": "Limit the effect to a mask: a named mask, @sel, @alpha:<layer>, @mask:<layer>, or a grayscale image path Type: mask.",
        "x-pixelox-kind": "mask"
      },
      "invert_mask": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Apply outside the mask instead of inside it Type: flag.",
        "x-pixelox-kind": "flag"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/fill.noise.result.json",
    "title": "pixelox fill.noise envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "fill.noise"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^PXW[0-9]{4}$"
            },
            "message": {
              "type": "string"
            },
            "context": {
              "type": "object"
            }
          }
        }
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "docs",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^PX[0-9]{4}$"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "docs": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      }
    }
  },
  "errors": [
    "PX1002",
    "PX1003",
    "PX1004",
    "PX1010",
    "PX1011",
    "PX1012",
    "PX1013",
    "PX1101",
    "PX1103",
    "PX1105",
    "PX1106",
    "PX1108",
    "PX1401",
    "PX1403",
    "PX2301",
    "PX2302",
    "PX2304",
    "PX2311",
    "PX2312",
    "PX2313",
    "PX9001"
  ]
}
