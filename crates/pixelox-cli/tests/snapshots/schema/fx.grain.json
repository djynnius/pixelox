{
  "command": "fx.grain",
  "cli": "pixelox fx grain",
  "summary": "Add or replace a layer's film grain",
  "category": "fx",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/fx.grain.params.json",
    "title": "pixelox fx.grain parameters",
    "description": "Add or replace a layer's film grain",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "amount": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 400.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Strength: 15 subtle, 30 visible print grain, 60 heavy Range: 0..400. Type: number.",
        "default": "30",
        "x-pixelox-kind": "float"
      },
      "size": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.3,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Grain size in px; auto scales with the canvas (1.5 px at 1080 px) Range: 0.3..100. Type: number.",
        "default": "auto",
        "x-pixelox-kind": "float"
      },
      "roughness": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "0 = soft round clumps, 100 = crisp grain with fine detail Range: 0..100. Type: number.",
        "default": "50",
        "x-pixelox-kind": "float"
      },
      "color": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Color grain: 0 = monochrome, 100 = independent per channel Range: 0..100. Type: number.",
        "default": "0",
        "x-pixelox-kind": "float"
      },
      "tone": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "How much the grain follows the tone: 0 = even, 100 = none in pure black or white Range: 0..100. Type: number.",
        "default": "60",
        "x-pixelox-kind": "float"
      },
      "variant": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0.0,
            "maximum": 4294967295.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Grain pattern number: auto keeps the layer's current pattern or picks one from the op's seed (--seed) Range: 0..4294967295. Type: integer.",
        "default": "auto",
        "x-pixelox-kind": "int"
      },
      "enabled": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "on|off; given alone, turns the layer's existing grain on or off and keeps its settings Type: on|off.",
        "default": "on",
        "x-pixelox-kind": "switch"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/fx.grain.result.json",
    "title": "pixelox fx.grain envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "fx.grain"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
