{
  "command": "transform.move",
  "cli": "pixelox transform move",
  "summary": "Move a layer",
  "category": "transform",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/transform.move.params.json",
    "title": "pixelox transform.move parameters",
    "description": "Move a layer",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Layer to transform: name, #N (1 = top), @top, @bottom, @active (default: the only layer) Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "to": {
        "type": "string",
        "examples": [
          "50%,120"
        ],
        "description": "Destination X,Y for the anchor point of the layer's bounds Type: X,Y.",
        "x-pixelox-kind": "point"
      },
      "by": {
        "type": "string",
        "examples": [
          "50%,120"
        ],
        "description": "Offset DX,DY in px (or % of the canvas) Type: X,Y.",
        "x-pixelox-kind": "point"
      },
      "anchor": {
        "type": "string",
        "enum": [
          "tl",
          "t",
          "tr",
          "l",
          "c",
          "r",
          "bl",
          "b",
          "br"
        ],
        "description": "Which point of the bounds lands on --to: tl t tr l c r bl b br Type: choice.",
        "default": "tl",
        "x-pixelox-kind": "choice"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/transform.move.result.json",
    "title": "pixelox transform.move envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "transform.move"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^PXW[0-9]{4}$"
            },
            "message": {
              "type": "string"
            },
            "context": {
              "type": "object"
            }
          }
        }
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "docs",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^PX[0-9]{4}$"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "docs": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      }
    }
  },
  "errors": [
    "PX1002",
    "PX1003",
    "PX1004",
    "PX1010",
    "PX1011",
    "PX1101",
    "PX1103",
    "PX1105",
    "PX1106",
    "PX1108",
    "PX1401",
    "PX1403",
    "PX2301",
