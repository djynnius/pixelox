{
  "command": "retouch.frequency-split",
  "cli": "pixelox retouch frequency-split",
  "summary": "Frequency separation into Low and High layers",
  "category": "retouch",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/retouch.frequency-split.params.json",
    "title": "pixelox retouch.frequency-split parameters",
    "description": "Frequency separation into Low and High layers",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Source layer, any kind (rendered with its styles): name, #N (1 = top), @top, @bottom, or @active; default: the only layer, else the active one Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "radius": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1000.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Gaussian sigma in px between the bands: detail finer than this goes to High (auto = 0.15% of the long side, at least 2) Range: 0.5..1000. Type: number.",
        "default": "auto",
        "x-pixelox-kind": "float"
      },
      "name": {
        "type": "string",
        "description": "Name of the new group (made unique; its layers are Low and High) Type: text.",
        "default": "Frequency Separation",
        "x-pixelox-kind": "str"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
