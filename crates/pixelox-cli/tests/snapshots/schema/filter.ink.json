{
  "command": "filter.ink",
  "cli": "pixelox filter ink",
  "summary": "Pen and ink: crisp lines, solid blacks",
  "category": "filter",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/filter.ink.params.json",
    "title": "pixelox filter.ink parameters",
    "description": "Pen and ink: crisp lines, solid blacks",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "stroke": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.2,
            "maximum": 200.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Line width in px; auto = 1.0 × √(w·h)/1000 (recorded) Range: 0.2..200. Type: number.",
        "default": "auto",
        "x-pixelox-kind": "float"
      },
      "detail": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Line detail: 0 = only major edges, 100 = fine texture too Range: 0..100. Type: number.",
        "default": "50",
        "x-pixelox-kind": "float"
      },
      "fill": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "How much of the dark areas become solid ink Range: 0..100. Type: number.",
        "default": "35",
        "x-pixelox-kind": "float"
      },
      "shading": {
        "type": "string",
        "enum": [
          "none",
          "hatch",
          "stipple"
        ],
        "description": "Mid-tone shading: none, hatch (crosshatched lines), or stipple (dots) Type: choice.",
        "default": "none",
        "x-pixelox-kind": "choice"
      },
      "angle": {
        "type": "string",
        "examples": [
          "45"
        ],
        "description": "Hatching direction in degrees counter-clockwise from the right Type: degrees.",
        "default": "45",
        "x-pixelox-kind": "angle"
      },
      "ink": {
        "type": "string",
        "examples": [
          "#0ea5e9"
        ],
        "description": "Ink color Type: color.",
        "default": "#141414",
        "x-pixelox-kind": "color"
      },
      "paper": {
        "type": "string",
        "examples": [
          "#0ea5e9"
        ],
        "description": "Paper color Type: color.",
        "default": "#fbfaf5",
        "x-pixelox-kind": "color"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "mask": {
        "type": "string",
        "examples": [
          "@sel"
        ],
        "description": "Limit the effect to a mask: a named mask, @sel, @alpha:<layer>, @mask:<layer>, or a grayscale image path Type: mask.",
        "x-pixelox-kind": "mask"
      },
      "invert_mask": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Apply outside the mask instead of inside it Type: flag.",
        "x-pixelox-kind": "flag"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
