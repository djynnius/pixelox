{
  "command": "fx.copy",
  "cli": "pixelox fx copy",
  "summary": "Copy a layer's style stack to other layers",
  "category": "fx",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
