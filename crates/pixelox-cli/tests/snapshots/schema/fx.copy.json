    "title": "pixelox fx.copy parameters",
    "description": "Copy a layer's style stack to other layers",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "from": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Layer to copy the styles from Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "to": {
        "description": "Comma-separated layers to paste the styles onto Type: list. Repeatable.",
        "oneOf": [
          {
            "type": "string",
            "description": "Comma-separated layers to paste the styles onto Type: list.",
            "x-pixelox-kind": "list"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Comma-separated layers to paste the styles onto Type: list.",
              "x-pixelox-kind": "list"
            }
          }
        ]
      }
    },
    "required": [
      "input",
      "from",
      "to"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
