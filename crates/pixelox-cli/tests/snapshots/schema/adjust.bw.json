{
  "command": "adjust.bw",
  "cli": "pixelox adjust bw",
  "summary": "Black & white with per-color weights",
  "category": "adjust",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/adjust.bw.params.json",
    "title": "pixelox adjust.bw parameters",
    "description": "Black & white with per-color weights",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "preset": {
        "type": "string",
        "enum": [
          "default",
          "red-filter",
          "yellow-filter",
          "green-filter",
          "blue-filter",
          "high-contrast-red",
          "high-contrast-blue",
          "infrared",
          "darker",
          "lighter",
          "maximum-black",
          "maximum-white"
        ],
        "description": "Starting weights (Photoshop-like filter presets) Type: choice.",
        "default": "default",
        "x-pixelox-kind": "choice"
      },
      "r": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -200.0,
            "maximum": 300.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Reds weight in % (overrides the preset) Range: -200..300. Type: number.",
        "x-pixelox-kind": "float"
      },
      "y": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -200.0,
            "maximum": 300.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Yellows weight in % (overrides the preset) Range: -200..300. Type: number.",
        "x-pixelox-kind": "float"
      },
      "g": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -200.0,
            "maximum": 300.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Greens weight in % (overrides the preset) Range: -200..300. Type: number.",
        "x-pixelox-kind": "float"
      },
      "c": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -200.0,
            "maximum": 300.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Cyans weight in % (overrides the preset) Range: -200..300. Type: number.",
        "x-pixelox-kind": "float"
      },
      "b": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -200.0,
            "maximum": 300.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Blues weight in % (overrides the preset) Range: -200..300. Type: number.",
        "x-pixelox-kind": "float"
      },
      "m": {
        "oneOf": [
          {
            "type": "number",
            "minimum": -200.0,
            "maximum": 300.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Magentas weight in % (overrides the preset) Range: -200..300. Type: number.",
        "x-pixelox-kind": "float"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "mask": {
        "type": "string",
        "examples": [
          "@sel"
        ],
        "description": "Limit the effect to a mask: a named mask, @sel, @alpha:<layer>, @mask:<layer>, or a grayscale image path Type: mask.",
        "x-pixelox-kind": "mask"
      },
      "invert_mask": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Apply outside the mask instead of inside it Type: flag.",
        "x-pixelox-kind": "flag"
      },
      "as_layer": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Create a non-destructive adjustment layer instead of changing pixels Type: flag.",
        "x-pixelox-kind": "flag"
      },
      "name": {
        "type": "string",
        "description": "Name for the new layer (default: generated, unique) Type: text.",
        "x-pixelox-kind": "str"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
