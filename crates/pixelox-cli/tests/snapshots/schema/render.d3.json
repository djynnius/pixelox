{
  "command": "render.d3",
  "cli": "pixelox render d3",
  "summary": "Run a d3 script (d3 bundle via --lib) to SVG or PNG",
  "category": "render",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/render.d3.params.json",
    "title": "pixelox render.d3 parameters",
    "description": "Run a d3 script (d3 bundle via --lib) to SVG or PNG",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "size": {
        "type": "string",
        "examples": [
          "1080x1350"
        ],
        "description": "Default size for px.canvas()/px.svg() called without arguments (px.width, px.height); also the raster size when an SVG result is written to PNG and --size is given Type: WxH.",
        "default": "800x600",
        "x-pixelox-kind": "size"
      },
      "data": {
        "description": "name=file: expose a file as px.data.name (.csv/.tsv → array of row objects, .json → parsed, else text); repeatable Type: text. Repeatable.",
        "oneOf": [
          {
            "type": "string",
            "description": "name=file: expose a file as px.data.name (.csv/.tsv → array of row objects, .json → parsed, else text); repeatable Type: text.",
            "x-pixelox-kind": "str"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "description": "name=file: expose a file as px.data.name (.csv/.tsv → array of row objects, .json → parsed, else text); repeatable Type: text.",
              "x-pixelox-kind": "str"
            }
          }
        ]
      },
      "param": {
        "description": "k=v: expose a string value as px.params.k; repeatable Type: text. Repeatable.",
        "oneOf": [
          {
            "type": "string",
            "description": "k=v: expose a string value as px.params.k; repeatable Type: text.",
            "x-pixelox-kind": "str"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "description": "k=v: expose a string value as px.params.k; repeatable Type: text.",
              "x-pixelox-kind": "str"
            }
          }
        ]
      },
      "lib": {
        "description": "Local JavaScript library to load before the script (a classic/UMD script, or a self-contained ES module: .mjs, *.module.js, or top-level export); repeatable Type: path. Repeatable.",
        "oneOf": [
          {
            "type": "string",
            "description": "Local JavaScript library to load before the script (a classic/UMD script, or a self-contained ES module: .mjs, *.module.js, or top-level export); repeatable Type: path.",
            "x-pixelox-kind": "path"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Local JavaScript library to load before the script (a classic/UMD script, or a self-contained ES module: .mjs, *.module.js, or top-level export); repeatable Type: path.",
              "x-pixelox-kind": "path"
            }
          }
        ]
      },
      "timeout": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Wall-clock limit for the whole run (seconds, or 500ms, 2m); exceeding it fails with PX6002 Type: duration.",
        "default": "30s",
        "x-pixelox-kind": "duration"
      },
      "js_mem": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 16.0,
            "maximum": 16384.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Memory limit in MB for the JS heap plus canvases; exceeding it fails with PX6003 Range: 16..16384. Type: integer.",
        "default": "512",
        "x-pixelox-kind": "int"
      },
      "allow_time": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Let Date.now()/new Date() read the real clock (otherwise 0); breaks determinism and warns PXW6001 Type: flag.",
        "x-pixelox-kind": "flag"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
