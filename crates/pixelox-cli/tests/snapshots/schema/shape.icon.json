{
  "command": "shape.icon",
  "cli": "pixelox shape icon",
  "summary": "Add a Lucide icon as a shape layer",
  "category": "vector",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/shape.icon.params.json",
    "title": "pixelox shape.icon parameters",
    "description": "Add a Lucide icon as a shape layer",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "icon": {
        "type": "string",
        "description": "Icon name or alias, e.g. calendar, map-pin, ticket Type: text.",
        "x-pixelox-kind": "str"
      },
      "size": {
        "type": "string",
        "examples": [
          "12px"
        ],
        "description": "Icon size (width = height) in px or % of the shorter canvas side Type: length.",
        "default": "48",
        "x-pixelox-kind": "length"
      },
      "at": {
        "type": "string",
        "examples": [
          "50%,120"
        ],
        "description": "Position X,Y of the icon's anchor point (px or %); negative counts from the right/bottom Type: X,Y.",
        "x-pixelox-kind": "point"
      },
      "anchor": {
        "type": "string",
        "enum": [
          "tl",
          "t",
          "tr",
          "l",
          "c",
          "r",
          "bl",
          "b",
          "br"
        ],
        "description": "Which point of the box sits at --at (default tl; alone: align to that canvas point; neither: centered) Type: choice.",
        "x-pixelox-kind": "choice"
      },
      "above": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Insert the new layer directly above this layer (default: on top of the stack) Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "below": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Insert the new layer directly below this layer Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "into": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Insert the new layer on top of this group's children Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "rotation": {
        "type": "string",
        "examples": [
          "45"
        ],
        "description": "Clockwise rotation in degrees about the icon's center Type: degrees.",
        "default": "0",
        "x-pixelox-kind": "angle"
      },
      "color": {
        "type": "string",
        "examples": [
          "#0ea5e9"
        ],
        "description": "Line color Type: color.",
        "default": "#000000",
        "x-pixelox-kind": "color"
      },
      "stroke_width": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1000.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Line width in px; auto = size / 12 (Lucide's 2 units) Range: 0..1000. Type: number.",
        "default": "auto",
        "x-pixelox-kind": "float"
      },
      "fill": {
        "type": "string",
        "description": "Fill for the icon's closed outlines (CSS color), or none Type: text.",
        "default": "none",
        "x-pixelox-kind": "str"
      },
      "opacity": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Layer opacity 0-100 Range: 0..100. Type: number.",
        "default": "100",
        "x-pixelox-kind": "float"
      },
      "name": {
        "type": "string",
        "description": "Layer name (default: the icon name, made unique) Type: text.",
        "x-pixelox-kind": "str"
      }
    },
    "required": [
      "input",
      "icon"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/shape.icon.result.json",
    "title": "pixelox shape.icon envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "shape.icon"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
