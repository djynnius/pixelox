{
  "command": "filter.surface-blur",
  "cli": "pixelox filter surface-blur",
  "summary": "Edge-preserving surface blur (bilateral)",
  "category": "filter",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/filter.surface-blur.params.json",
    "title": "pixelox filter.surface-blur parameters",
    "description": "Edge-preserving surface blur (bilateral)",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "radius": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0.0,
            "maximum": 100.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Spatial radius of the box window in px (0 = no change) Range: 0..100. Type: integer.",
        "default": "5",
        "x-pixelox-kind": "int"
      },
      "threshold": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 255.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Edge threshold in levels 0..255: larger differences are not averaged (0 = no change) Range: 0..255. Type: number.",
        "default": "15",
        "x-pixelox-kind": "float"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "mask": {
        "type": "string",
        "examples": [
          "@sel"
        ],
        "description": "Limit the effect to a mask: a named mask, @sel, @alpha:<layer>, @mask:<layer>, or a grayscale image path Type: mask.",
        "x-pixelox-kind": "mask"
      },
      "invert_mask": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Apply outside the mask instead of inside it Type: flag.",
        "x-pixelox-kind": "flag"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/filter.surface-blur.result.json",
