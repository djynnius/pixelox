{
  "command": "transform.crop",
  "cli": "pixelox transform crop",
  "summary": "Crop the document",
  "category": "transform",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/transform.crop.params.json",
    "title": "pixelox transform.crop parameters",
    "description": "Crop the document",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "rect": {
        "type": "string",
        "examples": [
          "10,20,300x200"
        ],
        "description": "Keep this rectangle X,Y,WxH (clipped to the canvas) Type: X,Y,WxH.",
        "x-pixelox-kind": "rect"
      },
      "auto": {
        "type": "string",
        "enum": [
          "trim"
        ],
        "description": "trim: remove a uniform or transparent border (like `transform trim`) Type: choice.",
        "x-pixelox-kind": "choice"
      },
      "ratio": {
        "type": "string",
        "description": "Aspect ratio W:H (4:5, 16:9, or 1.5): the largest such rectangle Type: text.",
        "x-pixelox-kind": "str"
      },
      "gravity": {
        "type": "string",
        "enum": [
          "tl",
          "t",
          "tr",
          "l",
          "c",
          "r",
          "bl",
          "b",
          "br"
        ],
        "description": "Where a --ratio crop sits: tl t tr l c r bl b br Type: choice.",
        "default": "c",
        "x-pixelox-kind": "choice"
      },
      "content_aware": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Seam-carving retarget (stretch feature; not in this build) Type: flag.",
        "x-pixelox-kind": "flag"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/transform.crop.result.json",
    "title": "pixelox transform.crop envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "transform.crop"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^PXW[0-9]{4}$"
            },
            "message": {
              "type": "string"
            },
            "context": {
              "type": "object"
            }
          }
        }
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "docs",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^PX[0-9]{4}$"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "docs": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      }
    }
  },
  "errors": [
    "PX1002",
    "PX1003",
    "PX1004",
    "PX1010",
    "PX1011",
