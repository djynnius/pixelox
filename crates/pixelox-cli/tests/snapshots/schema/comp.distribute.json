    "description": "Distribute layers with even or fixed spacing",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layers": {
        "description": "Layers to distribute (comma-separated, at least two) Type: list. Repeatable.",
        "oneOf": [
          {
            "type": "string",
            "description": "Layers to distribute (comma-separated, at least two) Type: list.",
            "x-pixelox-kind": "list"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Layers to distribute (comma-separated, at least two) Type: list.",
              "x-pixelox-kind": "list"
            }
          }
        ]
      },
      "axis": {
        "type": "string",
        "enum": [
          "x",
          "y"
        ],
        "description": "Axis to distribute along: x (horizontal) or y (vertical) Type: choice.",
        "default": "x",
        "x-pixelox-kind": "choice"
      },
      "spacing": {
        "type": "string",
        "description": "Gap between neighbours: even, or a length such as 24 or 2% Type: text.",
        "default": "even",
        "x-pixelox-kind": "str"
      }
    },
    "required": [
      "input",
      "layers"
    ],
    "additionalProperties": false,
