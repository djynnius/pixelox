{
  "command": "filter.displace",
  "cli": "pixelox filter displace",
  "summary": "Displace by an image, layer, or noise map",
  "category": "filter",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/filter.displace.params.json",
    "title": "pixelox filter.displace parameters",
    "description": "Displace by an image, layer, or noise map",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "map": {
        "type": "string",
        "description": "Displacement map image (grayscale or color) Type: path.",
        "x-pixelox-kind": "path"
      },
      "map_layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Use another layer of the document as the map Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "mode": {
        "type": "string",
        "enum": [
          "rg",
          "slope"
        ],
        "description": "rg: red/green channels move x/y (Photoshop); slope: move along brightness slopes (glass, fabric) Type: choice.",
        "default": "rg",
        "x-pixelox-kind": "choice"
      },
      "amount": {
        "type": "string",
        "examples": [
          "12px"
        ],
        "description": "Largest move in px or % of the shorter canvas side Type: length.",
        "default": "2%",
        "x-pixelox-kind": "length"
      },
      "fit": {
        "type": "string",
        "enum": [
          "stretch",
          "tile"
        ],
        "description": "Map image or layer: stretch over the layer's bounds, or tile from the canvas origin Type: choice.",
        "default": "stretch",
        "x-pixelox-kind": "choice"
      },
      "scale": {
        "type": "string",
        "examples": [
          "12px"
        ],
        "description": "Noise map: feature size in px or % of the shorter canvas side Type: length.",
        "default": "12%",
        "x-pixelox-kind": "length"
      },
      "octaves": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1.0,
            "maximum": 10.0
          },
          {
            "type": "string",
            "pattern": "^(-?[0-9]+|auto)$"
          }
        ],
        "description": "Noise map: detail layers Range: 1..10. Type: integer.",
        "default": "3",
        "x-pixelox-kind": "int"
      },
      "edge": {
        "type": "string",
        "enum": [
          "auto",
          "clamp",
          "wrap",
          "transparent"
        ],
        "description": "Pixels pulled from outside the layer: auto (clamp on opaque layers, transparent otherwise), clamp, wrap, or transparent Type: choice.",
        "default": "auto",
        "x-pixelox-kind": "choice"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "mask": {
        "type": "string",
        "examples": [
          "@sel"
        ],
        "description": "Limit the effect to a mask: a named mask, @sel, @alpha:<layer>, @mask:<layer>, or a grayscale image path Type: mask.",
        "x-pixelox-kind": "mask"
      },
      "invert_mask": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Apply outside the mask instead of inside it Type: flag.",
        "x-pixelox-kind": "flag"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/filter.displace.result.json",
    "title": "pixelox filter.displace envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "filter.displace"
      },
