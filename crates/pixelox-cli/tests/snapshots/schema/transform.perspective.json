{
  "command": "transform.perspective",
  "cli": "pixelox transform perspective",
  "summary": "Map a layer's corners to a quad",
  "category": "transform",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/transform.perspective.params.json",
    "title": "pixelox transform.perspective parameters",
    "description": "Map a layer's corners to a quad",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Layer to transform: name, #N (1 = top), @top, @bottom, @active (default: the only layer) Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "quad": {
        "type": "string",
        "examples": [
          "0,0 128,150 255,255"
        ],
        "description": "Four corners 'x1,y1 x2,y2 x3,y3 x4,y4': top-left, top-right, bottom-right, bottom-left Type: points.",
        "x-pixelox-kind": "points"
      },
      "interp": {
        "type": "string",
        "enum": [
          "nearest",
          "bilinear",
          "bicubic",
          "lanczos3"
        ],
        "description": "Resampling filter: nearest, bilinear, bicubic, lanczos3; auto = Lanczos-3 when shrinking, bicubic otherwise Type: choice.",
        "default": "auto",
        "x-pixelox-kind": "choice"
      }
    },
    "required": [
      "input",
      "quad"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/transform.perspective.result.json",
