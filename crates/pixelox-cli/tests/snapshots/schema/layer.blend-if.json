    "title": "pixelox layer.blend-if parameters",
    "description": "Show a layer only where tones fall in ranges",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "layer": {
        "type": "string",
        "examples": [
          "@top"
        ],
        "description": "Target layer: name, #N (1 = top), @top, @bottom, or @active; required when the document has several layers Type: layer.",
        "x-pixelox-kind": "layer"
      },
      "this": {
        "type": "string",
        "description": "This layer's visible range: B,W or B1,B2,W1,W2 on 0..255 Type: text.",
        "default": "0,255",
        "x-pixelox-kind": "str"
      },
      "underlying": {
        "type": "string",
        "description": "The underlying composite's range: B,W or B1,B2,W1,W2 on 0..255 Type: text.",
        "default": "0,255",
        "x-pixelox-kind": "str"
      },
      "channel": {
        "type": "string",
        "enum": [
          "gray",
          "red",
          "green",
          "blue"
        ],
        "description": "Channel the ranges read: gray (luma), red, green, or blue Type: choice.",
        "default": "gray",
        "x-pixelox-kind": "choice"
      },
      "off": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Remove Blend If from the layer Type: flag.",
        "x-pixelox-kind": "flag"
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
