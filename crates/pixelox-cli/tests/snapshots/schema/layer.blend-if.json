{
  "command": "layer.blend-if",
  "cli": "pixelox layer blend-if",
  "summary": "Show a layer only where tones fall in ranges",
  "category": "layer",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
