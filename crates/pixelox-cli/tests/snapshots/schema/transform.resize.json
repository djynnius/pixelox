{
  "command": "transform.resize",
  "cli": "pixelox transform resize",
  "summary": "Resample the document to a new size",
  "category": "transform",
  "mode": "mutate",
  "milestone": null,
  "x-pixelox-schema-version": "1.0.0",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/transform.resize.params.json",
    "title": "pixelox transform.resize parameters",
    "description": "Resample the document to a new size",
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "description": "Input file: an image, PSD, SVG, or .pxo document"
      },
      "output": {
        "type": "string",
        "description": "Output path (-o); format from the extension"
      },
      "in_place": {
        "type": "boolean",
        "description": "Mutate the input .pxo document instead of writing -o"
      },
      "size": {
        "type": "string",
        "examples": [
          "1080x1350"
        ],
        "description": "New canvas size WxH (2048x keeps aspect, 50% halves) Type: WxH.",
        "x-pixelox-kind": "size"
      },
      "interp": {
        "type": "string",
        "enum": [
          "nearest",
          "bilinear",
          "bicubic",
          "lanczos3"
        ],
        "description": "Resampling filter: nearest, bilinear, bicubic, lanczos3; auto = Lanczos-3 when shrinking, bicubic otherwise Type: choice.",
        "default": "auto",
        "x-pixelox-kind": "choice"
      },
      "sharpen": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0.0,
            "maximum": 2.0
          },
          {
            "type": "string"
          }
        ],
        "description": "Unsharp amount after resampling: auto (scaled to the reduction) or 0..2; 0 = none Range: 0..2. Type: number.",
        "default": "0",
        "x-pixelox-kind": "float"
      }
    },
    "required": [
      "input",
      "size"
    ],
    "additionalProperties": false,
    "x-pixelox-schema-version": "1.0.0"
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/pixelox/schema/v1/transform.resize.result.json",
    "title": "pixelox transform.resize envelope",
    "type": "object",
    "required": [
      "tool",
      "version",
      "envelope",
      "command",
      "ok",
      "dry_run",
      "seed",
      "inputs",
      "outputs",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "tool": {
        "const": "pixelox"
      },
      "version": {
        "type": "string"
      },
      "envelope": {
        "const": 1
      },
      "command": {
        "const": "transform.resize"
      },
      "ok": {
        "type": "boolean"
      },
      "dry_run": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer"
      },
      "result": {
        "type": "object",
        "description": "Command-specific; doc ops include op, params, and document. Dry runs include plan."
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            },
            "sidecar": {
              "type": "string"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "format": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^PXW[0-9]{4}$"
            },
            "message": {
              "type": "string"
            },
            "context": {
              "type": "object"
            }
          }
        }
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "docs",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^PX[0-9]{4}$"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "docs": {
            "type": "string"
          },
          "context": {
            "type": "object"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      }
    }
  },
  "errors": [
    "PX1002",
    "PX1003",
    "PX1004",
    "PX1010",
